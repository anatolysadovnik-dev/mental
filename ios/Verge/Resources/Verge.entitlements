<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. Обязателен в App Store, если есть другие способы входа. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- APNs sandbox — только для Debug (симулятор/отладка на устройстве).
	     Beta и Release используют VergeRelease.entitlements (production), см. project.yml. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
